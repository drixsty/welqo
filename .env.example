# ─────────────────────────────────────────────────────────────
#  Welqo — Environment Variables
#  Copy this file to .env and fill in the values
#  NEVER commit .env to git
# ─────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://welqo:welqo_secret@localhost:5432/welqo_dev"
POSTGRES_USER=welqo
POSTGRES_PASSWORD=welqo_secret
POSTGRES_DB=welqo_dev

# ── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://:redis_secret@localhost:6379"
REDIS_PASSWORD=redis_secret

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Beds24 ─────────────────────────────────────────────────
BEDS24_API_KEY=your_beds24_api_key_here
BEDS24_BASE_URL=https://api.beds24.com/v2

# ── Sync ───────────────────────────────────────────────────
SYNC_INTERVAL_MS=600000  # 10 minutes

# ── Next.js (public vars — safe to expose to browser) ──────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002

# ── Email (Resend) ─────────────────────────────────────────
# Créer un compte gratuit sur https://resend.com
# Laisser vide = mode mock (emails loggés en console)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@welqo.fr

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
